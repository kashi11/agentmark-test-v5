# Provider key for the model used by the prompt (openai/gpt-5-mini).
OPENAI_API_KEY=sk-...

# AgentMark Cloud credentials (created on the AgentMark app setup page).
# Used for tracing and for the Cloud prompt loader when NODE_ENV != development.
AGENTMARK_API_KEY=
AGENTMARK_APP_ID=
# Optional: override the Cloud gateway. Leave unset to use the default.
# AGENTMARK_BASE_URL=
